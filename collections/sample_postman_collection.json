              "});",
              "",
              "pm.test(\"updatedAt is a valid date string\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(new Date(jsonData.updatedAt).toString()).to.not.eql(\"Invalid Date\");",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", function () {",
